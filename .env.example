# Local Environment Settings (Template)
# Copy this file to .env (git-ignored) and populate with your project values.

# Google Cloud / ADK Settings
GOOGLE_API_KEY="your_api_key_here"
PROJECT_ID="example-project-id"
REGION="europe-west4"

# Model Settings (ADK Orchestrator & Subagents)
GEMINI_PRO_MODEL="gemini-3.1-pro"       # Deep reasoning, planning, and complex evaluation
GEMINI_FLASH_MODEL="gemini-3.8-flash"   # High-throughput ingestion, parsing, and fast validation
GEMINI_MODEL="gemini-3.1-pro"           # Fallback default if tier is unspecified

# Application Server Settings
API_HOST="0.0.0.0"
API_PORT="8000"

# Telemetry (OpenTelemetry OTLP Collector)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
