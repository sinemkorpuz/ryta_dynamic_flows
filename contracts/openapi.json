  },
  "components": {
    "schemas": {
      "CheckoutRequest": {
        "properties": {
          "payment_method_token": {
            "type": "string",
            "title": "Payment Method Token",
            "default": "visa_4412"
          }
        },
        "type": "object",
        "title": "CheckoutRequest",
        "description": "Request body for confirming one-tap checkout."
      },
      "ConfirmSeatsRequest": {
        "properties": {
          "seat_designators": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seat Designators"
          }
        },
        "type": "object",
        "title": "ConfirmSeatsRequest",
        "description": "Request body for confirming selected seat designators."
      },
      "CreateSessionRequest": {
        "properties": {
          "persona_id": {
            "type": "string",
            "title": "Persona Id",
            "default": "marta_byrne"
          },
          "signal_overrides": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signal Overrides"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest",
        "description": "Request body for initializing a dynamic flow session."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OfferActionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^(add|update_quantity|decline_page|remove_item|navigate_back|continue)$",
            "title": "Action"
          },
          "current_screen": {
            "type": "string",
            "title": "Current Screen",
            "default": "offer_page_1"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "OfferActionRequest",
        "description": "Request body for recording offer card and navigation interactions."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
